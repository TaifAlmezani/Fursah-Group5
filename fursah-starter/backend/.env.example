# FURSAH backend settings. Copy to .env and adjust. All keys use the FURSAH_ prefix.
# EVERY value here is OPTIONAL: with none of them set, the application runs fully in a
# deterministic, keyless mode (retrieval + ranking + grounding only). The model below is
# used only to enrich query understanding and phrase recommendation reasons.

# --- Optional LLM provider (OpenRouter, OpenAI-compatible) ---
# Used for the RAG semantic re-rank + Arabic reason phrasing. Leave FURSAH_MODEL_API_KEY
# blank to run fully without a model (deterministic ranking fallback).
FURSAH_MODEL_PROVIDER=
FURSAH_MODEL_BASE_URL=
# Qwen: cost-efficient and strong in Arabic. Use qwen/qwen-2.5-72b-instruct for higher quality.
FURSAH_MODEL_NAME=
FURSAH_MODEL_API_KEY=
FURSAH_MODEL_TIMEOUT_SECONDS=40
FURSAH_MODEL_MAX_RETRIES=1

# --- Workflow budget ---
FURSAH_WORKFLOW_TIMEOUT_SECONDS=90

# --- Evaluation time ---
# Blank = real request time. The classroom exercise pins noon Riyadh on 18 Oct 2026:
# FURSAH_EVALUATION_TIME=2026-10-18T12:00:00+03:00
FURSAH_EVALUATION_TIME=

# --- Frontend CORS origins ---
FURSAH_ALLOWED_ORIGINS=

# --- Optional Phoenix tracing (Day 4). Requires requirements-observability.txt when true. ---
# Orchestration is LangGraph (langchain), so 'langchain' gives graph/node spans. Our LLM
# calls go through plain httpx (not LangChain), so they are recorded by our own manual LLM
# spans in agent.LlmClient.complete — set 'langchain', not 'openai'/'auto'.
FURSAH_PHOENIX_ENABLED=false
FURSAH_PHOENIX_INSTRUMENT=langchain
FURSAH_PHOENIX_PROJECT=fursah
